{
  "info": {
    "name": "PulseConnector API (Full)",
    "description": "Full Postman collection for PulseConnector backend (exact current endpoints)",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "base_url", "value": "http://localhost:5000" },
    { "key": "namespace", "value": "default" },
    { "key": "endpoint", "value": "example" },
    { "key": "id", "value": "1" }
  ],
  "item": [

    {
      "name": "Health & Status",
      "item": [
        {
          "name": "Health",
          "request": { "method": "GET", "url": "{{base_url}}/api/health" }
        },
        {
          "name": "Status",
          "request": { "method": "GET", "url": "{{base_url}}/api/status" }
        },
        {
          "name": "Version",
          "request": { "method": "GET", "url": "{{base_url}}/api/version" }
        }
      ]
    },

    {
      "name": "Server Control",
      "item": [
        {
          "name": "Start Server",
          "request": { "method": "POST", "url": "{{base_url}}/api/server/start" }
        },
        {
          "name": "Stop Server",
          "request": { "method": "POST", "url": "{{base_url}}/api/server/stop" }
        }
      ]
    },

    {
      "name": "Auth",
      "item": [
        {
          "name": "Login",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"admin\",\n  \"password\": \"password\"\n}"
            },
            "url": "{{base_url}}/api/login"
          }
        }
      ]
    },

    {
      "name": "Admin - Objects & Schema",
      "item": [
        {
          "name": "List Objects",
          "request": { "method": "GET", "url": "{{base_url}}/api/admin/objects" }
        },
        {
          "name": "List Schema Objects",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"connection_id\": \"conn_id\",\n  \"object_type\": \"table\"\n}"
            },
            "url": "{{base_url}}/api/admin/schema/objects"
          }
        }
      ]
    },

    {
      "name": "Admin - Dialects",
      "item": [
        {
          "name": "List Dialects",
          "request": { "method": "GET", "url": "{{base_url}}/api/admin/dialects" }
        },
        {
          "name": "Create Dialect",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"key\": \"postgres\",\n  \"name\": \"PostgreSQL\",\n  \"supported_versions\": [\"13\", \"14\"],\n  \"is_active\": true\n}"
            },
            "url": "{{base_url}}/api/admin/dialects"
          }
        }
      ]
    },

    {
      "name": "Admin - Data Sources",
      "item": [
        {
          "name": "List Data Sources",
          "request": { "method": "GET", "url": "{{base_url}}/api/admin/data-sources" }
        },
        {
          "name": "Create Data Source",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"local\",\n  \"dialect_id\": \"postgres\",\n  \"host\": \"localhost\",\n  \"port\": 5432,\n  \"username\": \"postgres\",\n  \"password\": \"secret\",\n  \"database_name\": \"test\"\n}"
            },
            "url": "{{base_url}}/api/admin/data-sources"
          }
        },
        {
          "name": "Update Data Source",
          "request": {
            "method": "PUT",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{ \"host\": \"127.0.0.1\" }" },
            "url": "{{base_url}}/api/admin/data-sources/{{id}}"
          }
        },
        {
          "name": "Delete Data Source",
          "request": {
            "method": "DELETE",
            "url": "{{base_url}}/api/admin/data-sources/{{id}}"
          }
        }
      ]
    },

    {
      "name": "Admin - Users",
      "item": [
        {
          "name": "Create User",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{ \"user\": \"test\", \"password_hash\": \"secret\" }" },
            "url": "{{base_url}}/api/admin/users"
          }
        },
        {
          "name": "List Users",
          "request": { "method": "GET", "url": "{{base_url}}/api/admin/users" }
        },
        {
          "name": "Get User",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{ \"user\": \"test\" }" },
            "url": "{{base_url}}/api/admin/users/get"
          }
        },
        {
          "name": "Update User",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{ \"user\": \"test\", \"display_name\": \"Updated\" }" },
            "url": "{{base_url}}/api/admin/users/update"
          }
        },
        {
          "name": "Disable User",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{ \"user\": \"test\", \"action\": 0 }" },
            "url": "{{base_url}}/api/admin/users/disable"
          }
        }
      ]
    },

    {
      "name": "Admin - Groups",
      "item": [
        {
          "name": "Create Group",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{ \"group\": \"admins\" }" },
            "url": "{{base_url}}/api/admin/groups"
          }
        },
        {
          "name": "List Groups",
          "request": { "method": "GET", "url": "{{base_url}}/api/admin/groups" }
        },
        {
          "name": "Get Group",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{ \"group\": \"admins\" }" },
            "url": "{{base_url}}/api/admin/groups/get"
          }
        },
        {
          "name": "Update Group",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{ \"group\": \"admins\", \"display_name\": \"Admins\" }" },
            "url": "{{base_url}}/api/admin/groups/update"
          }
        },
        {
          "name": "Disable Group",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{ \"group\": \"admins\", \"action\": 0 }" },
            "url": "{{base_url}}/api/admin/groups/disable"
          }
        },
        {
          "name": "Add User to Group",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{ \"group\": \"admins\", \"user\": \"test\" }" },
            "url": "{{base_url}}/api/admin/groups/add-user"
          }
        },
        {
          "name": "Remove User from Group",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{ \"group\": \"admins\", \"user\": \"test\" }" },
            "url": "{{base_url}}/api/admin/groups/remove-user"
          }
        },
        {
          "name": "Group Members",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{ \"group\": \"admins\" }" },
            "url": "{{base_url}}/api/admin/groups/members"
          }
        }
      ]
    },

    {
      "name": "Admin - Permissions",
      "item": [
        {
          "name": "Create Permission",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"subjects\": [\"test\"],\n  \"endpoints\": { \"orders\": [\"read\"] }\n}"
            },
            "url": "{{base_url}}/api/admin/permissions"
          }
        },
        {
          "name": "List Permissions",
          "request": { "method": "GET", "url": "{{base_url}}/api/admin/permissions" }
        },
        {
          "name": "Get Permission",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{ \"uid\": \"perm_id\" }" },
            "url": "{{base_url}}/api/admin/permissions/get"
          }
        },
        {
          "name": "Disable Permission",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{ \"uid\": \"perm_id\", \"action\": 0 }" },
            "url": "{{base_url}}/api/admin/permissions/disable"
          }
        }
      ]
    },

    {
      "name": "OData",
      "item": [
        {
          "name": "OData GET",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/api/odata/{{namespace}}/{{endpoint}}?$select=*&$top=10"
          }
        },
        {
          "name": "OData INSERT",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{ \"field\": \"value\" }" },
            "url": "{{base_url}}/api/odata/{{namespace}}/{{endpoint}}"
          }
        },
        {
          "name": "OData UPDATE",
          "request": {
            "method": "PUT",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{ \"field\": \"new value\" }" },
            "url": "{{base_url}}/api/odata/{{namespace}}/{{endpoint}}/{{id}}"
          }
        }
      ]
    }

  ]
}
