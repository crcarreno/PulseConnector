{
  "info": {
    "name": "PulseConnector IAM",
    "description": "IAM Admin API for Users, Groups, Endpoints and Permissions",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "base_url",
      "value": "https://localhost:5000"
    }
  ],
  "item": [
    {
      "name": "Users",
      "item": [
        {
          "name": "Create User",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{base_url}}/admin/users",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"user\": \"user1\",\n  \"display_name\": \"User Test 1\",\n  \"password_hash\": \"123456\"\n}"
            }
          }
        },
        {
          "name": "List Users",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/admin/users"
          }
        },
        {
          "name": "Get User",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{base_url}}/admin/users/get",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"user\": \"user1\"\n}"
            }
          }
        },
        {
          "name": "Update User",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{base_url}}/admin/users/update",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"user\": \"user1\",\n  \"display_name\": \"User Updated\",\n  \"password_hash\": \"newhash\"\n}"
            }
          }
        },
        {
          "name": "Disable User",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{base_url}}/admin/users/disable",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"user\": \"user1\",\n  \"action\": 0\n}"
            }
          }
        }
      ]
    },
    {
      "name": "Groups",
      "item": [
        {
          "name": "Create Group",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{base_url}}/admin/groups",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"group\": \"public\",\n  \"display_name\": \"Public Group\"\n}"
            }
          }
        },
        {
          "name": "List Groups",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/admin/groups"
          }
        },
        {
          "name": "Get Group",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{base_url}}/admin/groups/get",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"group\": \"public\"\n}"
            }
          }
        },
        {
          "name": "Update Group",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{base_url}}/admin/groups/update",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"group\": \"public\",\n  \"display_name\": \"Public Updated\"\n}"
            }
          }
        },
        {
          "name": "Disable Group",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{base_url}}/admin/groups/disable",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"group\": \"public\",\n  \"action\": 0\n}"
            }
          }
        },
        {
          "name": "Add User to Group",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{base_url}}/admin/groups/add-user",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"group\": \"public\",\n  \"user\": \"user1\"\n}"
            }
          }
        },
        {
          "name": "Remove User from Group",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{base_url}}/admin/groups/remove-user",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"group\": \"public\",\n  \"user\": \"user1\"\n}"
            }
          }
        },
        {
          "name": "List Group Members",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{base_url}}/admin/groups/members",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"group\": \"public\"\n}"
            }
          }
        }
      ]
    },
    {
      "name": "Endpoints",
      "item": [
        {
          "name": "Create Endpoint",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{base_url}}/admin/endpoints",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"get_data_orders\",\n  \"dialect\": \"mssql\",\n  \"database\": \"northwind\",\n  \"type\": \"table\",\n  \"source\": \"Orders\",\n  \"namespace\": \"sqlserver\",\n  \"primary_key\": \"OrderID\"\n}"
            }
          }
        },
        {
          "name": "List Endpoints",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/admin/endpoints"
          }
        },
        {
          "name": "Get Endpoint",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{base_url}}/admin/endpoints/get",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"get_data_orders\"\n}"
            }
          }
        },
        {
          "name": "Update Endpoint",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{base_url}}/admin/endpoints/update",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"get_data_orders\",\n  \"source\": \"OrdersArchive\"\n}"
            }
          }
        }
      ]
    },
    {
      "name": "Permissions",
      "item": [
        {
          "name": "Create Permission",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{base_url}}/admin/permissions",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"by\": \"user\",\n  \"target\": \"user1\",\n  \"endpoints\": [\n    { \"name\": \"get_data_orders\", \"actions\": [\"read\", \"write\"] }\n  ]\n}"
            }
          }
        },
        {
          "name": "List Permissions",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/admin/permissions"
          }
        },
        {
          "name": "Get Permission",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{base_url}}/admin/permissions/get",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"uid\": 1\n}"
            }
          }
        },
        {
          "name": "Disable Permission",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{base_url}}/admin/permissions/disable",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"uid\": 1,\n  \"action\": 0\n}"
            }
          }
        }
      ]
    },
    {
      "name": "Dialects",
      "item": [
        {
          "name": "List Dialects",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/admin/dialects"
          }
        },
        {
          "name": "Create Dialect",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "url": "{{base_url}}/admin/dialects",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"key\": \"mysql\",\n  \"name\": \"MySQL\",\n  \"supported_versions\": \">=5.7\",\n  \"is_active\": true\n}"
            }
          }
        },
        {
          "name": "Update Dialect",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "url": "{{base_url}}/admin/dialects/{{dialect_id}}",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"supported_versions\": \">=8.0\",\n  \"is_active\": true\n}"
            }
          }
        },
        {
          "name": "Disable Dialect",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "url": "{{base_url}}/admin/dialects/{{dialect_id}}",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"is_active\": false\n}"
            }
          }
        }
      ]
    },
    {
      "name": "Data Sources",
      "item": [
        {
          "name": "List Data Sources",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/admin/data-sources"
          }
        },
        {
          "name": "Create Data Source",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "url": "{{base_url}}/admin/data-sources",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Northwind MySQL\",\n  \"dialect_id\": \"{{dialect_id}}\",\n  \"host\": \"127.0.0.1\",\n  \"port\": 3306,\n  \"username\": \"root\",\n  \"password\": \"root\",\n  \"database_name\": \"northwind\",\n  \"is_active\": true\n}"
            }
          }
        },
        {
          "name": "Update Data Source",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "url": "{{base_url}}/admin/data-sources/{{data_source_id}}",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"host\": \"192.168.1.10\",\n  \"port\": 3306,\n  \"database_name\": \"northwind_v2\",\n  \"is_active\": true\n}"
            }
          }
        },
        {
          "name": "Delete Data Source",
          "request": {
            "method": "DELETE",
            "url": "{{base_url}}/admin/data-sources/{{data_source_id}}"
          }
        }
      ]
    }
  ]
}
